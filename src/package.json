{
  "name": "smartlenderup-platform",
  "version": "1.0.0",
  "description": "Comprehensive microfinance platform for Kenya with M-Pesa integration",
  "type": "module",
  "scripts": {
    "NOW": "node FIX_NOW.js && vite --open",
    "KILL": "node KILL_AND_RESTART.js",
    "INCOGNITO": "npm run dev && node OPEN_INCOGNITO.js",
    "EXTREME": "node EXTREME_FIX.js && npm run dev",
    "NUCLEAR-FIX": "node DELETE-SUPABASE-NOW.js && npm install && npm run dev",
    "dev": "vite --open",
    "start": "vite --open",
    "verify-clean": "node verify-no-supabase.js",
    "FIX": "node STOP_ERROR_NOW.js && npm run dev",
    "STOP-ERROR": "node STOP_ERROR_NOW.js && npm run dev",
    "nuclear": "node NUCLEAR_FIX.js",
    "fix-error": "node fix-error.js",
    "restart": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'STOP_AND_RESTART.bat' : 'chmod +x STOP_AND_RESTART.sh && ./STOP_AND_RESTART.sh', {stdio: 'inherit'})\"",
    "dev:fresh": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'START_FRESH.bat' : 'chmod +x START_FRESH.sh && ./START_FRESH.sh', {stdio: 'inherit'})\"",
    "fix": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'ABSOLUTE_FINAL_FIX.bat' : 'chmod +x ABSOLUTE_FINAL_FIX.sh && ./ABSOLUTE_FINAL_FIX.sh', {stdio: 'inherit'})\"",
    "test:wasm": "open TEST_WASM_BLOCKED.html || start TEST_WASM_BLOCKED.html || xdg-open TEST_WASM_BLOCKED.html",
    "verify": "node verify-fix.js",
    "build": "vite build --outDir dist",
    "build:check": "tsc && vite build --outDir dist",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "postinstall": "node scripts/remove-supabase.js",
    "fix-cache": "node OPEN_INCOGNITO.js",
    "check-cache": "node CHECK_IF_CACHE_ISSUE.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.263.1",
    "sonner": "^2.0.3",
    "recharts": "^2.8.0",
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.2.0",
    "stripe": "^14.0.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.5",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-hover-card": "^1.1.5",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.5",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.5",
    "@radix-ui/react-scroll-area": "^1.2.5",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.5",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.5",
    "@radix-ui/react-tabs": "^1.1.5",
    "@radix-ui/react-toast": "^1.2.5",
    "@radix-ui/react-toggle": "^1.1.5",
    "@radix-ui/react-toggle-group": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.0.0",
    "embla-carousel-react": "^8.0.0",
    "input-otp": "^1.2.4",
    "next-themes": "^0.2.1",
    "react-day-picker": "^8.10.0",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.27"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "@vercel/node": "^3.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alngumba-sys/smartlenderup.git"
  },
  "keywords": [
    "microfinance",
    "lending",
    "kenya",
    "mpesa",
    "loan-management",
    "sacco",
    "fintech"
  ],
  "author": "BV FUNGUO LTD",
  "license": "MIT"
}